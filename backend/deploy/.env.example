# AutoPRD.id — contoh konfigurasi.
# Salin menjadi .env lalu isi. JANGAN commit .env ke repo publik.

# Port HTTP server (default 3001; nginx reverse proxy di depan)
PORT=3001

# --- AI provider (failover: Meta -> Tiarina -> Kenari) ---
META_API_KEY=
TIARINA_API_KEY=
KENARI_API_KEY=

# Mode AI API wajib BYOK (1 = key server tidak dipakai sama sekali)
# BYOK_ONLY=1

# --- Supabase (Auth Google + Postgres). Kosongkan = mode lokal tanpa login ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Direktori data lokal (mode tanpa Supabase)
DATA_DIR=/opt/autoprd/data
